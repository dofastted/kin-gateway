{
  "sticky": {
    "enabled": true,
    "mode": "conversation",
    "ttl_seconds": 86400,
    "header_keys": [
      "x-session-id",
      "x-conversation-id",
      "x-claude-code-session-id",
      "x-client-request-id",
      "session-id",
      "thread-id"
    ],
    "body_keys": [
      "conversation_id",
      "session_id",
      "thread_id",
      "prompt_cache_key"
    ]
  },
  "concurrency": {
    "default_max_per_account": 20,
    "default_key_concurrency": 20
  },
  "quota": {
    "safety_ratio": 0.95,
    "block_on_5h": true,
    "block_on_7d": true,
    "block_statuses": [
      "rate_limited",
      "warning"
    ],
    "warn_ratio": 0.85
  },
  "logging": {
    "mode": "normal",
    "retain_days": 7
  },
  "pool": {
    "strategy": "weighted-round-robin",
    "max_waiters_per_account": 32,
    "fallback_wait_timeout_ms": 5000,
    "sticky_wait_timeout_ms": 15000,
    "worker_health_ttl_ms": 5000,
    "heartbeat_stale_ms": 15000
  },
  "failover": {
    "max_account_switches": 10,
    "max_total_attempts": 12,
    "total_retry_deadline_ms": 120000,
    "delivery_mode": "realtime"
  }
}
