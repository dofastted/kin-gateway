{
  "name": "kin-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "CRS Claude protocol gateway",
  "type": "module",
  "main": "src/server.mjs",
  "scripts": {
    "start": "node src/server.mjs",
    "test": "npm run test:node",
    "test:node": "node --test test/unit/*.test.mjs test/e2e/*.e2e.test.mjs",
    "test:go": "cd worker && go test ./...",
    "test:all": "npm run test:node && npm run test:go",
    "build:worker": "mkdir -p bin && cd worker && CGO_ENABLED=0 go build -trimpath -o ../bin/kin-worker ./cmd/kin-worker"
  },
  "dependencies": {
    "node-fetch": "^2.7.0",
    "socks-proxy-agent": "^10.1.0"
  }
}
